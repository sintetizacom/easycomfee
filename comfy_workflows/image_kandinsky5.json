{
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "AE\\ae.safetensors"
    }
  },
  "latente": {
    "class_type": "EmptyLatentImage",
    "inputs": {
      "width": 1344,
      "height": 768,
      "batch_size": 1
    }
  },
  "clip": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "Qwen\\qwen_2.5_vl_7b_fp8_scaled.safetensors",
      "clip_name2": "CLIP\\clip_l.safetensors",
      "type": "kandinsky5_image",
      "device": "default"
    }
  },
  "unet_base": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "Kandinsky5\\kandinsky5lite_t2i.safetensors",
      "weight_dtype": "default"
    }
  },
  "unet": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": [
        "unet_base",
        0
      ],
      "shift": 3.0
    }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "text": "A detective in a soaked neon alley at night, slow push-in, rain, distant traffic"
    }
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "text": ""
    }
  },
  "amostra": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "positive": [
        "pos",
        0
      ],
      "negative": [
        "neg",
        0
      ],
      "latent_image": [
        "latente",
        0
      ],
      "seed": 1,
      "steps": 50,
      "cfg": 3.5,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "decodifica": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "amostra",
        0
      ],
      "vae": [
        "vae",
        0
      ]
    }
  },
  "salva": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "decodifica",
        0
      ],
      "filename_prefix": "saida"
    }
  }
}