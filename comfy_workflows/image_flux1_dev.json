{
  "unet": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": {
      "ckpt_name": "Flux1\\flux1-dev-fp8.safetensors"
    }
  },
  "latente": {
    "class_type": "EmptySD3LatentImage",
    "inputs": {
      "width": 1344,
      "height": 768,
      "batch_size": 1
    }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "unet",
        1
      ],
      "text": "A detective in a soaked neon alley at night, slow push-in, rain, distant traffic"
    }
  },
  "neg": {
    "class_type": "ConditioningZeroOut",
    "inputs": {
      "conditioning": [
        "pos",
        0
      ]
    }
  },
  "amostra": {
    "class_type": "KSampler",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "positive": [
        "pos",
        0
      ],
      "negative": [
        "neg",
        0
      ],
      "latent_image": [
        "latente",
        0
      ],
      "seed": 1,
      "steps": 20,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0
    }
  },
  "decodifica": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "amostra",
        0
      ],
      "vae": [
        "unet",
        2
      ]
    }
  },
  "salva": {
    "class_type": "SaveImage",
    "inputs": {
      "images": [
        "decodifica",
        0
      ],
      "filename_prefix": "saida"
    }
  }
}