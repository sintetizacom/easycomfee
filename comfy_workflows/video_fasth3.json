{
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "Minimax\\fastvideo_fasth3_8step_v2_pruned_int8_convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "clip": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "Qwen\\qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors",
      "type": "minimax",
      "device": "default"
    }
  },
  "vae_v": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "Minimax\\minimax_h3_video_vae_fp16.safetensors"
    }
  },
  "desloca": {
    "class_type": "MiniMaxH3SigmaShift",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "shift_video": 10.0,
      "shift_audio": 3.0
    }
  },
  "backend": {
    "class_type": "ModelAttentionBackend",
    "inputs": {
      "model": [
        "desloca",
        0
      ],
      "attention": "comfy kitchen attention"
    }
  },
  "esparsa": {
    "class_type": "BlockSparseAttention",
    "inputs": {
      "model": [
        "backend",
        0
      ],
      "selection": "vsa",
      "selection.keep_percent": 10.0,
      "start_percent": 0.2,
      "end_percent": 1.0,
      "dense_blocks": "",
      "min_tokens": 12288,
      "extra_tokens": 256,
      "sink_conditioning": "exact_kv_and_rows",
      "verbose": false
    }
  },
  "img_ini": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "start_image.png"
    }
  },
  "img_ini_esc": {
    "class_type": "ImageResizeKJv2",
    "inputs": {
      "image": [
        "img_ini",
        0
      ],
      "width": 1280,
      "height": 704,
      "upscale_method": "lanczos",
      "keep_proportion": "pillarbox_blur",
      "pad_color": "0, 0, 0",
      "crop_position": "center",
      "divisible_by": 2
    }
  },
  "prep": {
    "class_type": "MiniMaxH3ImageToVideo",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "vae": [
        "vae_v",
        0
      ],
      "prompt": "A detective in a soaked neon alley at night, slow push-in, rain, distant traffic",
      "width": 1280,
      "height": 704,
      "length": 124,
      "first_frame": [
        "img_ini_esc",
        0
      ]
    }
  },
  "guia": {
    "class_type": "BasicGuider",
    "inputs": {
      "model": [
        "esparsa",
        0
      ],
      "conditioning": [
        "prep",
        0
      ]
    }
  },
  "sigmas": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": [
        "esparsa",
        0
      ],
      "scheduler": "simple",
      "steps": 8,
      "denoise": 1.0
    }
  },
  "amostrador": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "res_multistep"
    }
  },
  "ruido": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 1
    }
  },
  "passo": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "ruido",
        0
      ],
      "guider": [
        "guia",
        0
      ],
      "sampler": [
        "amostrador",
        0
      ],
      "sigmas": [
        "sigmas",
        0
      ],
      "latent_image": [
        "prep",
        1
      ]
    }
  },
  "decodifica": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": [
        "passo",
        0
      ],
      "vae": [
        "vae_v",
        0
      ]
    }
  },
  "vae_a": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "Minimax\\minimax_h3_audio_vae_fp32.safetensors"
    }
  },
  "som": {
    "class_type": "VAEDecodeAudio",
    "inputs": {
      "samples": [
        "passo",
        0
      ],
      "vae": [
        "vae_a",
        0
      ]
    }
  },
  "monta": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "decodifica",
        0
      ],
      "fps": 24,
      "audio": [
        "som",
        0
      ]
    }
  },
  "salva": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "monta",
        0
      ],
      "filename_prefix": "video",
      "format": "auto",
      "codec": "auto"
    }
  }
}