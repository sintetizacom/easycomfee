{
  "imagem": {
    "class_type": "LoadImage",
    "inputs": {
      "image": "start_image.png"
    }
  },
  "unet": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "HunyuanVideo15\\hunyuanvideo1.5_720p_i2v_fp16.safetensors",
      "weight_dtype": "default"
    }
  },
  "shift": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "model": [
        "unet",
        0
      ],
      "shift": 7.0
    }
  },
  "clip": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "Qwen\\qwen_2.5_vl_7b_fp8_scaled.safetensors",
      "clip_name2": "HunyuanVideo15\\byt5_small_glyphxl_fp16.safetensors",
      "type": "hunyuan_video_15",
      "device": "default"
    }
  },
  "vae": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "HunyuanVideo15\\hunyuanvideo15_vae_fp16.safetensors"
    }
  },
  "pos": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "text": "A detective in a soaked neon alley at night, slow push-in, rain, distant traffic"
    }
  },
  "neg": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "clip": [
        "clip",
        0
      ],
      "text": ""
    }
  },
  "visao": {
    "class_type": "CLIPVisionLoader",
    "inputs": {
      "clip_name": "SigCLIP\\sigclip_vision_patch14_384.safetensors"
    }
  },
  "visao_img": {
    "class_type": "CLIPVisionEncode",
    "inputs": {
      "clip_vision": [
        "visao",
        0
      ],
      "image": [
        "imagem",
        0
      ],
      "crop": "center"
    }
  },
  "cond": {
    "class_type": "HunyuanVideo15ImageToVideo",
    "inputs": {
      "positive": [
        "pos",
        0
      ],
      "negative": [
        "neg",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "width": 1280,
      "height": 720,
      "length": 121,
      "batch_size": 1,
      "start_image": [
        "imagem",
        0
      ],
      "clip_vision_output": [
        "visao_img",
        0
      ]
    }
  },
  "guia": {
    "class_type": "CFGGuider",
    "inputs": {
      "model": [
        "shift",
        0
      ],
      "positive": [
        "cond",
        0
      ],
      "negative": [
        "cond",
        1
      ],
      "cfg": 6.0
    }
  },
  "sigmas": {
    "class_type": "BasicScheduler",
    "inputs": {
      "model": [
        "shift",
        0
      ],
      "scheduler": "simple",
      "steps": 20,
      "denoise": 1.0
    }
  },
  "amostrador": {
    "class_type": "KSamplerSelect",
    "inputs": {
      "sampler_name": "euler"
    }
  },
  "ruido": {
    "class_type": "RandomNoise",
    "inputs": {
      "noise_seed": 1
    }
  },
  "amostra": {
    "class_type": "SamplerCustomAdvanced",
    "inputs": {
      "noise": [
        "ruido",
        0
      ],
      "guider": [
        "guia",
        0
      ],
      "sampler": [
        "amostrador",
        0
      ],
      "sigmas": [
        "sigmas",
        0
      ],
      "latent_image": [
        "cond",
        2
      ]
    }
  },
  "decodifica": {
    "class_type": "VAEDecodeTiled",
    "inputs": {
      "samples": [
        "amostra",
        0
      ],
      "vae": [
        "vae",
        0
      ],
      "tile_size": 512,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 8
    }
  },
  "monta": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "decodifica",
        0
      ],
      "fps": 24
    }
  },
  "salva": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "monta",
        0
      ],
      "filename_prefix": "video",
      "format": "auto",
      "codec": "auto"
    }
  }
}